# 访问项目的根路径
VITE_PUBLIC_PATH = /vue

# 路由模式（true: history、false: hash）
VITE_ROUTE_WEB_HISTORY = true

# 代理设置，可配置多个，不能换行，格式：[访问接口的根路径, 代理地址, 是否保持Host头]
# VITE_PROXY = [["/api","https://demo.thingsboard.io/api",true]]
VITE_PROXY = [["/api","http://127.0.0.1:18080/api",false],["/dashboard","http://127.0.0.1:18080",false,true],["/assets","http://127.0.0.1:18080",false,true],["/chunk-","http://127.0.0.1:18080",false,true],["/styles-","http://127.0.0.1:18080",false,true],["/polyfills-","http://127.0.0.1:18080",false,true],["/scripts-","http://127.0.0.1:18080",false,true],["/main-","http://127.0.0.1:18080",false,true],["/roboto-","http://127.0.0.1:18080",false,true],["/thingsboard.ico","http://127.0.0.1:18080",false,true],["/openclaw-api","http://127.0.0.1:8787/api",false],["/chart","http://127.0.0.1:18789/chart",false],["/alarm-api","http://127.0.0.1:8801",false]]

# OpenClaw 智能体后端接口前缀。开发环境通过上面的代理转发到 Flask /api。
VITE_OPENCLAW_API_BASE = /openclaw-api

# 是否删除 console 调试信息
VITE_DROP_CONSOLE = false

# 访问接口的根路径（例如：https://demo.thingsboard.com）建议为空
VITE_GLOB_API_URL =

# 访问接口的前缀，在根路径之后
VITE_GLOB_API_URL_PREFIX = 

# websocket 的访问接口的前缀，在根路径之后
VITE_GLOB_API_URL_WEBSOCKET = /api/ws

# ThingsBoard 基础地址（开发环境）
VITE_GLOB_TB_BASE_URL =
